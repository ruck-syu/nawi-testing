# Copy to .env and fill in your own values. Never commit .env.
# This is the ONLY database variable the app reads — the API connects to
# Supabase Postgres directly with it. Use the pooler URL (port 6543), not the
# direct connection: hosts without IPv6 hang on direct connections.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-region.pooler.supabase.com:6543/postgres
# Optional overrides (see server/src/config.ts for defaults)
# JWT_SECRET=
# PORT=4000
# CLIENT_ORIGIN=http://localhost:5173
# SITE_URL is only a fallback for script-driven report generation: reports
# created through the app point their verification QR at the request's own
# origin automatically. Set it to your public URL if you generate reports
# offline (e.g. https://your-app.up.railway.app).
# SITE_URL=http://127.0.0.1:4000
