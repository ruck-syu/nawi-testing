# Copy to .env and fill in your own values. Never commit .env.
# Use the Supabase pooler URL (port 6543), not the direct connection:
# hosts without IPv6 hang on direct connections.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Optional overrides (see server/src/config.ts for defaults)
# JWT_SECRET=
# PORT=4000
