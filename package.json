{
  "name": "r76-report-system",
  "private": true,
  "version": "0.1.0",
  "description": "OIML R76 digital type-test report system for non-automatic weighing instruments",
  "type": "module",
  "workspaces": [
    "packages/*",
    "server"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/src/index.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/src/index.ts",
    "seed": "node --disable-warning=ExperimentalWarning server/src/db/seed.ts",
    "seed:reset": "node --disable-warning=ExperimentalWarning server/src/db/seed.ts --reset",
    "test": "bash scripts/run-domain-tests.sh",
    "verify": "bash scripts/verify.sh",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.40.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0"
  }
}
