# application, not part of it.
server/uploads/
server/reports/

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Environment and secrets
.env
.env.*
env
!.env.example

# Agent memory & internal workflow notes
AGENT_MEMORY.md
.agent-memory.md
MEMORY.md

# Logs
*.log
npm-debug.log*

